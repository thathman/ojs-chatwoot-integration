# Excluded from `git archive` (and therefore from the real release
# package built via `git archive`) — CI/dev-only content with no purpose
# inside an installed OJS plugin directory. Everything else (source,
# templates, locale, docs, LICENSE, version.xml) ships as-is.
.forgejo/ export-ignore
.github/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.php-cs-fixer.php export-ignore
.php-cs-fixer.cache export-ignore
tests/ export-ignore
