msgstr "Chatwoot Base URL"

msgid "plugins.generic.chatwootIntegration.settings.chatwootBaseUrl.description"
msgstr "The base URL of your Chatwoot installation (e.g., https://app.chatwoot.com)."

msgid "plugins.generic.chatwootIntegration.settings.chatwootWebsiteToken"
msgstr "Website Token"

msgid "plugins.generic.chatwootIntegration.settings.chatwootWebsiteToken.description"
msgstr "The website token from your Chatwoot inbox settings."

msgid "plugins.generic.chatwootIntegration.settings.chatwootIdentityValidationSecret"
msgstr "Identity Validation Secret"

msgid "plugins.generic.chatwootIntegration.settings.chatwootIdentityValidationSecret.description"
msgstr "The HMAC secret key for identity validation (optional but recommended)."

msgid "plugins.generic.chatwootIntegration.settings.chatwootApiAccessToken"
msgstr "API Access Token"

msgid "plugins.generic.chatwootIntegration.settings.chatwootApiAccessToken.description"
msgstr "An Agent/Admin API Access Token for advanced features like Canned Responses and Notes."

msgid "plugins.generic.chatwootIntegration.settings.chatwootInboxId"
msgstr "Inbox ID"

msgid "plugins.generic.chatwootIntegration.settings.chatwootInboxId.description"
msgstr "Required for open/update conversation mode when no existing conversation is found."

msgid "plugins.generic.chatwootIntegration.settings.chatwootCaptainAssistantId"
msgstr "Captain Assistant ID"

msgid "plugins.generic.chatwootIntegration.settings.chatwootCaptainAssistantId.description"
msgstr "The numeric ID of the Chatwoot Captain assistant this journal's Knowledge Document, Custom Tools, and Scenarios should be provisioned under. Required for Sync/Repair Captain to do anything — without it, Captain provisioning silently does nothing."

msgid "plugins.generic.chatwootIntegration.settings.chatwootSupportApiToken"
msgstr "Support API Token"

msgid "plugins.generic.chatwootIntegration.settings.chatwootSupportApiToken.description"
msgstr "Shared secret Chatwoot Captain must send as a Bearer token when calling the conversation-bound Support API. Required for that API to respond."

msgid "plugins.generic.chatwootIntegration.settings.mcpEndpoint.description"
msgstr "MCP-capable clients (e.g. an AI agent) can reach this journal's read-only support tools at %endpoint%, speaking MCP protocol revision %revision%. See the MCP setup guide for details."

msgid "plugins.generic.chatwootIntegration.settings.mcpServiceToken"
msgstr "MCP Service Token"

msgid "plugins.generic.chatwootIntegration.settings.mcpServiceToken.description"
msgstr "Shared secret an MCP client must send as a Bearer token when calling the MCP gateway above. Distinct from the Support API Token above — never reuse one for the other."

